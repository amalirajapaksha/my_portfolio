fill = "#8B4513",
color = "black",
linewidth = 1
) +
# Head
geom_polygon(
data = head,
aes(x, y),
fill = "#8B4513",
color = "black",
linewidth = 1
) +
# Ears
geom_polygon(
data = ear1,
aes(x, y),
fill = "#8B4513",
color = "black",
linewidth = 1
) +
geom_polygon(
data = ear2,
aes(x, y),
fill = "#8B4513",
color = "black",
linewidth = 1
) +
# Legs
geom_polygon(
data = leg1,
aes(x, y),
fill = "#8B4513",
color = "black",
linewidth = 1
) +
geom_polygon(
data = leg2,
aes(x, y),
fill = "#8B4513",
color = "black",
linewidth = 1
) +
geom_polygon(
data = leg3,
aes(x, y),
fill = "#8B4513",
color = "black",
linewidth = 1
) +
geom_polygon(
data = leg4,
aes(x, y),
fill = "#8B4513",
color = "black",
linewidth = 1
) +
# Eye
geom_point(
aes(x = 8.7, y = 8.5),
size = 4,
color = "black"
) +
# Nostril
geom_point(
aes(x = 9.0, y = 8.0),
size = 2,
color = "black"
) +
# Mane
geom_curve(
aes(
x = 6.5, y = 8.0,
xend = 5.8, yend = 6.0
),
curvature = 0.3,
linewidth = 4,
color = "black"
) +
# Tail
geom_curve(
aes(
x = 2.3, y = 4.5,
xend = 0.5, yend = 6.5
),
curvature = -0.5,
linewidth = 4,
color = "black"
) +
# Hooves
geom_segment(
aes(x = 2.4, y = 0.8, xend = 3.0, yend = 0.8),
linewidth = 3
) +
geom_segment(
aes(x = 3.5, y = 0.7, xend = 4.1, yend = 0.7),
linewidth = 3
) +
geom_segment(
aes(x = 5.3, y = 0.8, xend = 5.9, yend = 0.8),
linewidth = 3
) +
geom_segment(
aes(x = 6.2, y = 1.0, xend = 6.8, yend = 1.0),
linewidth = 3
) +
# Equal scaling
coord_fixed(
xlim = c(0, 10),
ylim = c(0, 11)
) +
theme_void()
library(ggplot2)
# -----------------------------
# Petal coordinates
# -----------------------------
petals <- data.frame(
x = c(
0, 0.7, 1.4, 0.7,
0, -0.7, -1.4, -0.7,
0, 0.7, 1.4, 0.7,
0, -0.7, -1.4, -0.7
),
y = c(
1.2, 2.0, 1.2, 0.4,
1.2, 2.0, 1.2, 0.4,
1.2, 0.5, 1.2, 1.9,
1.2, 0.5, 1.2, 1.9
)
)
# -----------------------------
# Create flower using ellipses
# -----------------------------
ggplot() +
# Petals
stat_ellipse(
aes(
x = 0,
y = 2.1
),
type = "norm"
) +
# Stem
geom_segment(
aes(
x = 0,
y = 0,
xend = 0,
yend = -4
),
linewidth = 5,
color = "forestgreen"
) +
# Left leaf
geom_polygon(
data = data.frame(
x = c(0, -1.5, -2.5, -1.2, 0),
y = c(-2, -1.5, -2.5, -3, -2.5)
),
aes(x, y),
fill = "forestgreen",
color = "darkgreen"
) +
# Right leaf
geom_polygon(
data = data.frame(
x = c(0, 1.5, 2.5, 1.2, 0),
y = c(-2.5, -2, -2.8, -3.2, -2.5)
),
aes(x, y),
fill = "forestgreen",
color = "darkgreen"
) +
# Flower petals
annotate(
"ellipse",
x0 = 0,
y0 = 2,
a = 1.2,
b = 2,
angle = 0,
fill = "pink",
color = "deeppink",
alpha = 0.8
) +
annotate(
"ellipse",
x0 = 1.5,
y0 = 1,
a = 1.2,
b = 2,
angle = -45,
fill = "pink",
color = "deeppink",
alpha = 0.8
) +
annotate(
"ellipse",
x0 = -1.5,
y0 = 1,
a = 1.2,
b = 2,
angle = 45,
fill = "pink",
color = "deeppink",
alpha = 0.8
) +
annotate(
"ellipse",
x0 = 0,
y0 = 0.5,
a = 1.2,
b = 2,
angle = 90,
fill = "pink",
color = "deeppink",
alpha = 0.8
) +
# Flower centre
annotate(
"point",
x = 0,
y = 1,
size = 12,
color = "gold"
) +
annotate(
"point",
x = 0,
y = 1,
size = 5,
color = "orange"
) +
coord_fixed(
xlim = c(-4, 4),
ylim = c(-5, 4)
) +
theme_void()
