library(ggplot2)
library(ggforce)
ggplot() +
# -------------------------------------------------------
# Stem
# -------------------------------------------------------
geom_curve(
aes(
x = 0, y = -0.5,
xend = 0.2, yend = -5
),
curvature = 0.05,
linewidth = 5,
color = "forestgreen"
) +
# -------------------------------------------------------
# Left leaf
# -------------------------------------------------------
geom_polygon(
data = data.frame(
x = c(0, -1.2, -2.7, -1.8, -0.5, 0),
y = c(-2.2, -1.8, -2.7, -3.2, -2.8, -2.2)
),
aes(x, y),
fill = "forestgreen",
color = "darkgreen",
linewidth = 1
) +
# -------------------------------------------------------
# Right leaf
# -------------------------------------------------------
geom_polygon(
data = data.frame(
x = c(0.1, 1.3, 2.7, 1.8, 0.6, 0.1),
y = c(-3.0, -2.2, -2.8, -3.5, -3.7, -3.0)
),
aes(x, y),
fill = "forestgreen",
color = "darkgreen",
linewidth = 1
) +
# -------------------------------------------------------
# Petal 1 - Top
# -------------------------------------------------------
geom_ellipse(
aes(
x0 = 0,
y0 = 2.5,
a = 1.25,
b = 2.0,
angle = 0
),
fill = "pink",
color = "deeppink",
linewidth = 1
) +
# -------------------------------------------------------
# Petal 2 - Upper right
# -------------------------------------------------------
geom_ellipse(
aes(
x0 = 1.55,
y0 = 1.55,
a = 1.25,
b = 2.0,
angle = -45 * pi / 180
),
fill = "pink",
color = "deeppink",
linewidth = 1
) +
# -------------------------------------------------------
# Petal 3 - Lower right
# -------------------------------------------------------
geom_ellipse(
aes(
x0 = 1.55,
y0 = 0.0,
a = 1.25,
b = 2.0,
angle = 45 * pi / 180
),
fill = "pink",
color = "deeppink",
linewidth = 1
) +
# -------------------------------------------------------
# Petal 4 - Bottom
# -------------------------------------------------------
geom_ellipse(
aes(
x0 = 0,
y0 = -0.3,
a = 1.25,
b = 2.0,
angle = 90 * pi / 180
),
fill = "pink",
color = "deeppink",
linewidth = 1
) +
# -------------------------------------------------------
# Petal 5 - Lower left
# -------------------------------------------------------
geom_ellipse(
aes(
x0 = -1.55,
y0 = 0.0,
a = 1.25,
b = 2.0,
angle = -45 * pi / 180
),
fill = "pink",
color = "deeppink",
linewidth = 1
) +
# -------------------------------------------------------
# Petal 6 - Upper left
# -------------------------------------------------------
geom_ellipse(
aes(
x0 = -1.55,
y0 = 1.55,
a = 1.25,
b = 2.0,
angle = 45 * pi / 180
),
fill = "pink",
color = "deeppink",
linewidth = 1
) +
# -------------------------------------------------------
# Flower centre
# -------------------------------------------------------
geom_point(
aes(x = 0, y = 1),
size = 18,
color = "gold"
) +
geom_point(
aes(x = 0, y = 1),
size = 8,
color = "orange"
) +
# -------------------------------------------------------
# Coordinate system
# -------------------------------------------------------
coord_fixed(
xlim = c(-5, 5),
ylim = c(-6, 5)
) +
# -------------------------------------------------------
# Remove everything except the drawing
# -------------------------------------------------------
theme_void()
